default_platform(:ios)

PROJECT_ROOT = File.expand_path("../..", __FILE__)

def required_env(name)
  value = ENV[name]
  UI.user_error!("Missing required environment variable #{name}") if value.to_s.empty?
  value
end

# App Store Connect API Key (shared across iOS lanes)
def api_key
  app_store_connect_api_key(
    key_id: required_env("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: required_env("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: File.expand_path(required_env("APP_STORE_CONNECT_KEY_PATH")),
  )
end

def app_store_key_path
  File.expand_path(required_env("APP_STORE_CONNECT_KEY_PATH"))
end

def google_play_json_key_path
  File.expand_path(required_env("GOOGLE_PLAY_JSON_KEY_PATH"))
end

platform :ios do
  desc "Build and distribute to Firebase App Distribution"
  lane :distribute do
    # Build Flutter iOS release
    sh("cd '#{PROJECT_ROOT}' && flutter build ios --release --no-codesign")

    key = api_key
    key_path = app_store_key_path

    # Fetch Ad Hoc provisioning profile for direct device install
    get_provisioning_profile(
      api_key: key,
      app_identifier: "com.hoopsconnect.hoopsConnect",
      adhoc: true,
      output_path: "#{PROJECT_ROOT}/build/ios/profiles",
      filename: "AdHoc_com.hoopsconnect.hoopsConnect.mobileprovision",
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]

    build_app(
      workspace: "#{PROJECT_ROOT}/ios/Runner.xcworkspace",
      scheme: "Runner",
      archive_path: "#{PROJECT_ROOT}/build/ios/archive/Runner.xcarchive",
      export_method: "ad-hoc",
      output_directory: "#{PROJECT_ROOT}/build/ios/ipa",
      output_name: "HoopsConnect.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.hoopsconnect.hoopsConnect" => profile_name,
        },
      },
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyIssuerID '#{required_env("APP_STORE_CONNECT_ISSUER_ID")}' " \
              "-authenticationKeyID '#{required_env("APP_STORE_CONNECT_KEY_ID")}' " \
              "-authenticationKeyPath '#{key_path}' " \
              "CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY='Apple Distribution' " \
              "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
    )

    firebase_app_distribution(
      app: "1:212612973375:ios:23ec778ad8cafa58db498a",
      ipa_path: "#{PROJECT_ROOT}/build/ios/ipa/HoopsConnect.ipa",
      groups: "testers",
      release_notes: "Latest build from fastlane",
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    key = api_key
    key_path = app_store_key_path

    # Compile Flutter without code signing
    sh("cd '#{PROJECT_ROOT}' && flutter build ios --release --no-codesign")

    # Fetch or create App Store distribution provisioning profile
    get_provisioning_profile(
      api_key: key,
      app_identifier: "com.hoopsconnect.hoopsConnect",
      output_path: "#{PROJECT_ROOT}/build/ios/profiles",
      filename: "AppStore_com.hoopsconnect.hoopsConnect.mobileprovision",
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]

    build_app(
      workspace: "#{PROJECT_ROOT}/ios/Runner.xcworkspace",
      scheme: "Runner",
      archive_path: "#{PROJECT_ROOT}/build/ios/archive/Runner.xcarchive",
      export_method: "app-store",
      output_directory: "#{PROJECT_ROOT}/build/ios/ipa",
      output_name: "HoopsConnect.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.hoopsconnect.hoopsConnect" => profile_name,
        },
      },
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyIssuerID '#{required_env("APP_STORE_CONNECT_ISSUER_ID")}' " \
              "-authenticationKeyID '#{required_env("APP_STORE_CONNECT_KEY_ID")}' " \
              "-authenticationKeyPath '#{key_path}' " \
              "CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY='Apple Distribution' " \
              "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
    )
  end
end

platform :android do
  desc "Build and distribute to Firebase App Distribution"
  lane :distribute do
    # Build the Flutter Android APK
    sh("cd '#{PROJECT_ROOT}' && flutter build apk --release")

    firebase_app_distribution(
      app: "1:212612973375:android:2b6139ac0f5ee182db498a",
      android_artifact_type: "APK",
      android_artifact_path: "#{PROJECT_ROOT}/build/app/outputs/flutter-apk/app-release.apk",
      groups: "testers",
      release_notes: "Latest build from fastlane",
    )
  end

  desc "Build and upload to Google Play internal testing"
  lane :beta do
    # Build the Flutter Android app bundle
    sh("cd '#{PROJECT_ROOT}' && flutter build appbundle --release")

    upload_to_play_store(
      track: "internal",
      aab: "#{PROJECT_ROOT}/build/app/outputs/bundle/release/app-release.aab",
      json_key: google_play_json_key_path,
      package_name: "com.hoopsconnect.hoops_connect",
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
