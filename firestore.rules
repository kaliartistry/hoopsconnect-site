rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authorization schema v1. Every authorized account requires a
    // server-owned, active membership document. Legacy user roles are never an
    // authority source because older clients could self-assign those fields.
    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function membershipPath(userId) {
      return /databases/$(database)/documents/memberships/$(userId);
    }

    function hasMembershipDoc() {
      return isAuthenticated() && exists(membershipPath(request.auth.uid));
    }

    function getUserDoc() {
      return get(userPath(request.auth.uid)).data;
    }

    function getMembershipDoc() {
      return get(membershipPath(request.auth.uid)).data;
    }

    function currentRole() {
      return getMembershipDoc().role;
    }

    function currentAssociationId() {
      return getMembershipDoc().associationId;
    }

    function hasCapability(capability) {
      return isAuthenticated()
        && hasMembershipDoc()
        && getMembershipDoc().status == 'active'
        && getMembershipDoc().authorizationSchemaVersion == 1
        && getMembershipDoc().capabilities is list
        && getMembershipDoc().capabilities.hasAny([capability]);
    }

    function isSameAssociation(assocId) {
      return isAuthenticated()
        && hasMembershipDoc()
        && getMembershipDoc().status == 'active'
        && getMembershipDoc().authorizationSchemaVersion == 1
        && currentAssociationId() == assocId;
    }

    function canReadAssociation(assocId) {
      return isSameAssociation(assocId) && hasCapability('association.read');
    }

    function canManageAssociation(assocId) {
      return isSameAssociation(assocId) && hasCapability('association.manage');
    }

    function canManageTeams(assocId) {
      return isSameAssociation(assocId) && hasCapability('teams.manage');
    }

    function canManagePosts(assocId) {
      return isSameAssociation(assocId) && hasCapability('posts.manage');
    }

    function canEnterStats(assocId) {
      return isSameAssociation(assocId) && hasCapability('stats.enter');
    }

    function canApproveStats(assocId) {
      return isSameAssociation(assocId) && hasCapability('stats.approve');
    }

    function legacyOfficialStatWritesEnabled(assocId) {
      let path = /databases/$(database)/documents/associations/$(assocId)/domainControl/current;
      return !exists(path) || get(path).data.authorityMode in ['disabled', 'shadow'];
    }

    function divisionAcceptsNewReferences(assocId, divisionId) {
      let path = /databases/$(database)/documents/associations/$(assocId)/divisions/$(divisionId);
      return exists(path)
        && get(path).data.status != 'archived'
        && !('deletionPending' in get(path).data);
    }

    // ── Private identity and authorization data ────────────────────
    match /users/{userId} {
      allow get: if isAuthenticated() && (
        request.auth.uid == userId
        || (hasCapability('members.read')
          && resource.data.associationId == currentAssociationId())
      );
      allow list: if hasCapability('members.read')
        && resource.data.associationId == currentAssociationId();
      allow create: if false;
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'fcmTokens', 'notificationPrefs', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /memberships/{userId} {
      allow get: if isAuthenticated() && (
        request.auth.uid == userId
        || (hasCapability('members.read')
          && resource.data.associationId == currentAssociationId())
      );
      allow list: if hasCapability('members.read')
        && resource.data.associationId == currentAssociationId();
      allow create, update, delete: if false;
    }

    match /authorizationAudit/{entryId} {
      allow read: if hasCapability('members.read')
        && resource.data.associationId == currentAssociationId();
      allow write: if false;
    }

    match /inviteCodes/{inviteId} {
      allow get, list: if hasCapability('invites.manage')
        && resource.data.associationId == currentAssociationId();
      allow create, update, delete: if false;
    }

    // Callable-only idempotency records. They contain no bearer secrets, but
    // remain server-private to prevent operation replay analysis.
    match /authorizationOperationReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /leagueOperationReceipts/{receiptId} {
      allow read, write: if false;
    }

    // ── Association-scoped private application data ────────────────
    match /associations/{assocId} {
      allow read: if canReadAssociation(assocId);
      allow write: if canManageAssociation(assocId);

      match /seasons/{seasonId} {
        allow read: if canReadAssociation(assocId);
        allow write: if canManageAssociation(assocId);
      }

      match /divisions/{divisionId} {
        allow read: if canReadAssociation(assocId);
        allow create: if canManageAssociation(assocId)
          && request.resource.data.keys().hasOnly([
            'name', 'seasonId', 'description', 'status'
          ]);
        allow update: if canManageAssociation(assocId)
          && !('deletionPending' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'seasonId', 'description', 'status', 'archivedAt', 'updatedAt'
          ]);
        // Permanent deletion is callable-only. This also denies historical
        // administrator clients that still expose a direct delete action.
        allow delete: if false;
      }

      match /teams/{teamId} {
        allow read: if canReadAssociation(assocId);
        allow create: if (canManageTeams(assocId) || canManageAssociation(assocId))
          && request.resource.data.divisionId is string
          && divisionAcceptsNewReferences(assocId, request.resource.data.divisionId);
        allow update: if (canManageTeams(assocId) || canManageAssociation(assocId))
          && (
            request.resource.data.divisionId == resource.data.divisionId
            || (request.resource.data.divisionId is string
              && divisionAcceptsNewReferences(assocId, request.resource.data.divisionId))
          );
        allow delete: if canManageTeams(assocId) || canManageAssociation(assocId);
      }

      match /posts/{postId} {
        // Fans receive only explicitly public, non-acknowledgment posts. Ack
        // maps contain staff identity data and cannot be field-redacted.
        allow read: if canReadAssociation(assocId) && (
          hasCapability('posts.internal.read')
          || (resource.data.visibility == 'public'
            && resource.data.requiresAck == false)
        );

        allow create: if isSameAssociation(assocId)
          && hasCapability('posts.create')
          && request.resource.data.keys().hasAll([
            'authorId', 'authorName', 'authorRole', 'title', 'body', 'type',
            'createdAt', 'visibility', 'pinned', 'urgent', 'requiresAck',
            'expectedAcks', 'ackStatus'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == getUserDoc().displayName
          && request.resource.data.authorRole == currentRole()
          && request.resource.data.ackStatus.size() == 0
          && request.resource.data.expectedAcks.size() == 0
          && (
            currentRole() != 'rep'
            || (request.resource.data.visibility == 'public'
              && request.resource.data.pinned == false
              && request.resource.data.urgent == false
              && request.resource.data.requiresAck == false)
          );

        allow update: if canManagePosts(assocId)
          || (isSameAssociation(assocId)
            && hasCapability('posts.create')
            && request.auth.uid == resource.data.authorId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'body', 'imageUrl', 'divisionFilter', 'reactions'
            ]))
          || validOwnAcknowledgment(assocId);
        allow delete: if canManagePosts(assocId);
      }

      match /events/{eventId} {
        allow read: if canReadAssociation(assocId);
        // Creation, edit, reschedule, cancellation, and deletion are all
        // callable-only. Admin SDK writes from the trusted scheduler bypass
        // rules; no client role or historical capability can bypass this.
        allow create, update, delete: if false;
      }

      match /leagueWorkflowControl/{controlId} {
        allow get: if canReadAssociation(assocId)
          && resource.data.schemaVersion == 1;
        allow list: if false;
        allow write: if false;
      }

      match /scheduleLocks/{lockId} {
        allow read, write: if false;
      }

      match /schedulePairStarts/{lockId} {
        allow read, write: if false;
      }

      match /rosterWorkspaces/{workspaceId} {
        allow read, write: if false;
      }

      match /rosterRegistrations/{registrationId} {
        allow read, write: if false;
        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /rosterProposals/{proposalId} {
        allow read, write: if false;
        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /gameStats/{gameId} {
        allow read: if canReadAssociation(assocId);
        allow create: if legacyOfficialStatWritesEnabled(assocId)
          && canEnterStats(assocId) && validateGameStatsCreate(assocId, gameId);
        allow update: if legacyOfficialStatWritesEnabled(assocId)
          && canEnterStats(assocId) && validateGameStatsUpdate(assocId, gameId);
        allow delete: if legacyOfficialStatWritesEnabled(assocId)
          && canApproveStats(assocId);

        match /events/{eventId} {
          allow read: if canReadAssociation(assocId);
          allow create, update: if legacyOfficialStatWritesEnabled(assocId)
            && canEnterStats(assocId);
          allow delete: if false;
        }
      }


      // Authorization v2 sources are server-private. Packet 02 intentionally
      // exposes no direct client read or write; a later fixed-purpose callable
      // will return a minimized bootstrap DTO after one server transaction.
      match /access/{userId} {
        allow read, write: if false;
      }

      match /domainControl/{controlId} {
        allow read, write: if false;
      }

      match /competitions/{competitionId} {
        allow read, write: if false;

        match /seasons/{seasonId} {
          allow read, write: if false;

          match /access/{userId} {
            allow read, write: if false;
          }

          match /control/{controlId} {
            allow read, write: if false;
          }

          match /games/{gameId} {
            allow read, write: if false;

            match /assignments/{userId} {
              allow read, write: if false;
            }

            match /{document=**} {
              allow read, write: if false;
            }
          }

          // All remaining v2 canonical, evidence, receipt, aggregate and
          // publication-source records stay server-only in Packet 02.
          match /{document=**} {
            allow read, write: if false;
          }
        }
      }

      match /playerSeasonStats/{statId} {
        allow read: if canReadAssociation(assocId);
        // Derived aggregates are server-owned; roster administration must not
        // fabricate zero-filled statistical output.
        allow create, update, delete: if false;
      }

      match /leaderboard/{boardId} {
        allow read: if canReadAssociation(assocId);
        allow write: if false;
      }

      match /standings/{standingId} {
        allow read: if canReadAssociation(assocId);
        allow write: if false;
      }

      match /teamSeasonStats/{statId} {
        allow read: if canReadAssociation(assocId);
        allow write: if false;
      }
    }

    // Certified public DTOs are deliberately separate from private source
    // collections. No public writer exists in this tranche.
    match /publicData/{assocId}/{document=**} {
      allow read: if resource.data.associationId == assocId
        && resource.data.schemaVersion == 1
        && resource.data.published == true
        && resource.data.certificationStatus == 'certified';
      allow write: if false;
    }

    function validOwnAcknowledgment(assocId) {
      let uid = request.auth.uid;
      return isSameAssociation(assocId)
        && hasCapability('posts.acknowledge')
        && resource.data.requiresAck == true
        && uid in resource.data.expectedAcks
        && !(uid in resource.data.ackStatus)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackStatus'])
        && request.resource.data.ackStatus.diff(resource.data.ackStatus).affectedKeys().hasOnly([uid])
        && request.resource.data.ackStatus[uid].keys().hasOnly(['ackedAt', 'name', 'teamName'])
        && request.resource.data.ackStatus[uid].ackedAt == request.time
        && request.resource.data.ackStatus[uid].name == resource.data.expectedAcks[uid].name
        && request.resource.data.ackStatus[uid].teamName == resource.data.expectedAcks[uid].teamName;
    }

    function validateGameStatsUpdate(assocId, gameId) {
      let data = request.resource.data;
      let statusValid = !('status' in request.resource.data.diff(resource.data).affectedKeys())
        || data.status in ['draft', 'notStarted', 'inProgress', 'submitted', 'approved', 'rejected'];
      let approvalAllowed = (data.status != 'approved' && data.status != 'rejected')
        || canApproveStats(assocId);
      let approvalValid = data.status != 'approved' || data.approvedBy == request.auth.uid;
      let rejectionValid = data.status != 'rejected' || data.rejectedBy == request.auth.uid;
      let scoresValid = data.homeScore >= 0 && data.awayScore >= 0;
      return validStatEventReference(assocId, gameId) && statusValid && approvalAllowed
        && approvalValid && rejectionValid && scoresValid;
    }

    function validateGameStatsCreate(assocId, gameId) {
      let data = request.resource.data;
      let statusValid = data.status in ['draft', 'notStarted', 'inProgress', 'submitted', 'approved', 'rejected'];
      let approvalAllowed = (data.status != 'approved' && data.status != 'rejected')
        || canApproveStats(assocId);
      let approvalValid = data.status != 'approved' || data.approvedBy == request.auth.uid;
      let rejectionValid = data.status != 'rejected' || data.rejectedBy == request.auth.uid;
      let scoresValid = data.homeScore is number && data.awayScore is number
        && data.homeScore >= 0 && data.awayScore >= 0;
      return validStatEventReference(assocId, gameId) && statusValid && approvalAllowed
        && approvalValid && rejectionValid && scoresValid;
    }

    function validStatEventReference(assocId, gameId) {
      let path = /databases/$(database)/documents/associations/$(assocId)/events/$(gameId);
      return exists(path)
        && get(path).data.type == 'game'
        && get(path).data.divisionId is string
        && divisionAcceptsNewReferences(assocId, get(path).data.divisionId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
