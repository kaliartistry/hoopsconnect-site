rules_version = '2';

// ACCOUNT_LIFECYCLE_AD02_V2_TEST_ONLY_PROJECT=demo-hoopsconnect
// Candidate-only emulator policy. firebase.json does not reference this file.
service firebase.storage {
  match /b/{bucket}/o {
    function validId(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 128
        && value.matches('^[^\\x00-\\x1f\\x7f]{1,128}$');
    }

    function validPathId(value) {
      return value is string
        && value.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$');
    }

    function validCounter(value) {
      return value is number
        && value >= 0
        && value <= 9007199254740991
        && value % 1 == 0;
    }

    function providerTenantV2() {
      return request.auth.token.firebase.get('tenant', null);
    }

    function projectionPathV2(uid) {
      return request.auth.token.authTenantIdV2 == null
        ? /databases/(default)/documents/storageAuthorizationsV2Root/$(uid)
        : /databases/(default)/documents/storageAuthorizationsV2Tenants/$(request.auth.token.authTenantIdV2)/users/$(uid);
    }

    function validCapabilities(value) {
      return value is list
        && value.size() <= 64
        && value.size() == value.toSet().size()
        && value.hasOnly([
          'association.read', 'association.manage', 'members.read',
          'members.manage', 'invites.manage', 'schedule.manage',
          'teams.manage', 'teams.represent', 'posts.create', 'posts.manage',
          'posts.internal.read', 'posts.acknowledge', 'stats.enter',
          'stats.approve', 'stats.export', 'press.read', 'players.manage',
          'players.private.read', 'rosters.assert', 'rosters.manage',
          'games.schedule', 'stats.submit', 'stats.review', 'stats.correct',
          'stats.certify', 'results.publish', 'results.retract',
          'official.override'
        ]);
    }

    // AD02_TOKEN_V2_BEGIN: signed proof checks perform no document reads.
    function validTokenV2() {
      return request.auth != null
        && request.auth.token.keys().hasAll([
          'authIncarnationSchemaVersionV2', 'authProjectIdV2',
          'authTenantIdV2', 'authUidV2', 'accountGenerationV2',
          'accountLifecycleEpochV2', 'auth_time'
        ])
        && request.auth.token.authIncarnationSchemaVersionV2 == 2
        && request.auth.token.authProjectIdV2 == 'demo-hoopsconnect'
        && request.auth.token.aud == request.auth.token.authProjectIdV2
        && (request.auth.token.authTenantIdV2 == null
          || validPathId(request.auth.token.authTenantIdV2))
        && providerTenantV2() == request.auth.token.authTenantIdV2
        && request.auth.token.authUidV2 == request.auth.uid
        && validPathId(request.auth.token.authUidV2)
        && request.auth.token.accountGenerationV2 is string
        && request.auth.token.accountGenerationV2.matches('^[a-f0-9]{64}$')
        && validCounter(request.auth.token.accountLifecycleEpochV2)
        && validCounter(request.auth.token.auth_time);
    }
    // AD02_TOKEN_V2_END

    function projectionShape(data) {
      return data.keys().hasOnly([
          'authIncarnationSchemaVersionV2', 'authProjectIdV2',
          'authTenantIdV2', 'authUidV2', 'accountGenerationV2',
          'accountLifecycleEpochV2', 'lifecycleStateV2',
          'membershipStatusV2', 'reauthAfterSecV2', 'associationId',
          'capabilities'
        ])
        && data.authIncarnationSchemaVersionV2 == 2
        && data.accountGenerationV2 is string
        && data.accountGenerationV2.matches('^[a-f0-9]{64}$')
        && validCounter(data.accountLifecycleEpochV2)
        && validCounter(data.reauthAfterSecV2)
        && validId(data.associationId)
        && validCapabilities(data.capabilities);
    }

    // AD02_ACTIVE_V2_BEGIN: one Firestore projection read.
    function activeStorageV2(uid, associationId, capability) {
      let projection = firestore.get(projectionPathV2(uid)).data;
      return validTokenV2()
        && projectionShape(projection)
        && projection.authProjectIdV2 == 'demo-hoopsconnect'
        && projection.authProjectIdV2 == request.auth.token.authProjectIdV2
        && projection.authTenantIdV2 == request.auth.token.authTenantIdV2
        && projection.authUidV2 == uid
        && projection.authUidV2 == request.auth.token.authUidV2
        && projection.lifecycleStateV2 == 'active'
        && projection.membershipStatusV2 == 'active'
        && projection.associationId == associationId
        && request.auth.token.accountGenerationV2 == projection.accountGenerationV2
        && request.auth.token.accountLifecycleEpochV2 == projection.accountLifecycleEpochV2
        && request.auth.token.auth_time > projection.reauthAfterSecV2
        && projection.capabilities.hasAny([capability]);
    }
    // AD02_ACTIVE_V2_END

    match /candidateProtectedV2Root/{uid}/{generation}/{associationId}/{allPaths=**} {
      allow read: if resource != null
        && request.auth.token.authTenantIdV2 == null
        && request.auth.uid == uid
        && request.auth.token.accountGenerationV2 == generation
        && activeStorageV2(uid, associationId, 'association.read');
      // Generic Storage mutation stays closed in AD02. AD06 owns privacy
      // epoch and crash-safe multi-projection custody.
      allow create, update, delete: if false;
    }

    match /candidateProtectedV2Tenants/{tenantId}/users/{uid}/{generation}/{associationId}/{allPaths=**} {
      allow read: if resource != null
        && request.auth.token.authTenantIdV2 == tenantId
        && request.auth.uid == uid
        && request.auth.token.accountGenerationV2 == generation
        && activeStorageV2(uid, associationId, 'association.read');
      // Generic Storage mutation stays closed in AD02. AD06 owns privacy
      // epoch and crash-safe multi-projection custody.
      allow create, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
