rules_version = '2';

// ACCOUNT_DELETION_AD05D_V1_TEST_ONLY_PROJECT=demo-hoopsconnect
// Candidate-only policy. firebase.json does not reference this file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /accountDeletionJobsV1/{jobId}/{document=**} {
      allow read, write: if false;
    }
    match /candidateAd05dMediaEvidenceV1/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
