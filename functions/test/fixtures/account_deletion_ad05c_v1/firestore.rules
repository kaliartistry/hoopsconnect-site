rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /accountDeletionJobsV1/{jobId}/{document=**} {
      allow read, write: if false;
    }
    match /candidateAd05cSources/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
