rules_version = '2';

// ACCOUNT_DELETION_AD04_V1_TEST_ONLY_PROJECT=demo-hoopsconnect
// Server-private dormant candidate. firebase.json does not reference this file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /accountDeletionIntentsV1/{document=**} {
      allow read, write: if false;
    }
    match /accountDeletionJobsV1/{document=**} {
      allow read, write: if false;
    }
    match /accountDeletionStatusV1/{document=**} {
      allow read, write: if false;
    }
    match /accountDeletionStatusControlsV1/{document=**} {
      allow read, write: if false;
    }
    match /accountDeletionReceiptsV1/{document=**} {
      allow read, write: if false;
    }
    match /accountDeletionRevocationMaterialV1/{document=**} {
      allow read, write: if false;
    }
    match /accountDeletionProviderEventsV1/{document=**} {
      allow read, write: if false;
    }
    match /accountDeletionAlertsV1/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
