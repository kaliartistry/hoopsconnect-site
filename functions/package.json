{
  "name": "hoopsconnect-functions",
  "description": "Cloud Functions for HoopsConnect Jamaica Basketball App",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint --ext .ts src/",
    "test:functions": "npm run build && node --test test/membership.test.js",
    "test:functions:no-build": "node --test test/membership.test.js",
    "test:notifications": "node --test test/notification_authorization.test.js",
    "test:callable": "node --test test/callable.integration.test.js",
    "test:contracts": "npm run build && npm run test:contracts:no-build",
    "test:contracts:no-build": "node --test test/official_stats_contract.test.js test/account_deletion_contract.test.js",
    "test:rules": "node --test test/firestore.rules.test.js",
    "test:storage": "node --test test/storage.rules.test.js",
    "test:security": "npm run build && npm run test:security:no-build",
    "test:security:no-build": "npm run test:contracts:no-build && npm run test:functions:no-build && npm run test:notifications && npm run test:callable && npm run test:rules && npm run test:storage"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "firebase": "^12.18.0",
    "typescript": "^5.3.0"
  },
  "private": true
}
