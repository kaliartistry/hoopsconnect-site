rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function membership() {
      return firestore.get(
        /databases/(default)/documents/memberships/$(request.auth.uid)
      ).data;
    }

    function activeIn(assocId) {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/memberships/$(request.auth.uid)
        )
        && membership().authorizationSchemaVersion == 1
        && membership().status == 'active'
        && membership().associationId == assocId;
    }

    function hasCapability(assocId, capability) {
      return activeIn(assocId)
        && membership().capabilities is list
        && membership().capabilities.hasAny([capability]);
    }

    function imageType() {
      return request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/webp', 'image/gif'
      ];
    }

    function post(assocId, postId) {
      return firestore.get(
        /databases/(default)/documents/associations/$(assocId)/posts/$(postId)
      ).data;
    }

    function postExists(assocId, postId) {
      return firestore.exists(
        /databases/(default)/documents/associations/$(assocId)/posts/$(postId)
      );
    }

    function validPostMetadata(assocId, postId) {
      return request.resource.metadata.associationId == assocId
        && request.resource.metadata.postId == postId
        && request.resource.metadata.ownerUid == post(assocId, postId).authorId
        && request.resource.metadata.visibility == post(assocId, postId).visibility;
    }

    match /associations/{assocId}/posts/{postId}/{fileName} {
      allow read: if activeIn(assocId)
        && postExists(assocId, postId)
        && resource.metadata.associationId == assocId
        && resource.metadata.postId == postId
        && resource.metadata.ownerUid == post(assocId, postId).authorId
        && resource.metadata.visibility == post(assocId, postId).visibility
        && (
          hasCapability(assocId, 'posts.internal.read')
          || (post(assocId, postId).visibility == 'public'
            && post(assocId, postId).requiresAck == false)
        );
      allow create: if postExists(assocId, postId)
        && imageType()
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && validPostMetadata(assocId, postId)
        && (
          hasCapability(assocId, 'posts.manage')
          || (hasCapability(assocId, 'posts.create')
            && post(assocId, postId).authorId == request.auth.uid)
        );
      allow update: if postExists(assocId, postId)
        && imageType()
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && validPostMetadata(assocId, postId)
        && request.resource.metadata.associationId == resource.metadata.associationId
        && request.resource.metadata.postId == resource.metadata.postId
        && request.resource.metadata.ownerUid == resource.metadata.ownerUid
        && (
          hasCapability(assocId, 'posts.manage')
          || (hasCapability(assocId, 'posts.create')
            && post(assocId, postId).authorId == request.auth.uid)
        );
      allow delete: if postExists(assocId, postId)
        && resource.metadata.associationId == assocId
        && resource.metadata.postId == postId
        && resource.metadata.ownerUid == post(assocId, postId).authorId
        && resource.metadata.visibility == post(assocId, postId).visibility
        && (
          hasCapability(assocId, 'posts.manage')
          || (hasCapability(assocId, 'posts.create')
            && post(assocId, postId).authorId == request.auth.uid)
        );
    }

    function validTeamMetadata(assocId, teamId) {
      return request.resource.metadata.associationId == assocId
        && request.resource.metadata.teamId == teamId;
    }

    function teamExists(assocId, teamId) {
      return firestore.exists(
        /databases/(default)/documents/associations/$(assocId)/teams/$(teamId)
      );
    }

    match /associations/{assocId}/teams/{teamId}/{fileName} {
      allow read: if teamExists(assocId, teamId)
        && hasCapability(assocId, 'association.read')
        && resource.metadata.associationId == assocId
        && resource.metadata.teamId == teamId;
      allow create: if teamExists(assocId, teamId)
        && (hasCapability(assocId, 'teams.manage')
          || hasCapability(assocId, 'association.manage'))
        && imageType()
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && validTeamMetadata(assocId, teamId);
      allow update: if teamExists(assocId, teamId)
        && (hasCapability(assocId, 'teams.manage')
          || hasCapability(assocId, 'association.manage'))
        && imageType()
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && validTeamMetadata(assocId, teamId)
        && request.resource.metadata.associationId == resource.metadata.associationId
        && request.resource.metadata.teamId == resource.metadata.teamId;
      allow delete: if teamExists(assocId, teamId)
        && (hasCapability(assocId, 'teams.manage')
          || hasCapability(assocId, 'association.manage'))
        && resource.metadata.associationId == assocId
        && resource.metadata.teamId == teamId;
    }

    function documentType() {
      return imageType() || request.resource.contentType == 'application/pdf';
    }

    function validDocumentMetadata(assocId, documentId) {
      return request.resource.metadata.associationId == assocId
        && request.resource.metadata.documentId == documentId
        && request.resource.metadata.visibility == 'internal';
    }

    function documentExists(assocId, documentId) {
      return firestore.exists(
        /databases/(default)/documents/associations/$(assocId)/documents/$(documentId)
      );
    }

    match /associations/{assocId}/documents/{documentId}/{fileName} {
      allow read: if documentExists(assocId, documentId)
        && (hasCapability(assocId, 'press.read')
          || hasCapability(assocId, 'association.manage'))
        && resource.metadata.associationId == assocId
        && resource.metadata.documentId == documentId
        && resource.metadata.visibility == 'internal';
      allow create: if documentExists(assocId, documentId)
        && hasCapability(assocId, 'association.manage')
        && documentType()
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && validDocumentMetadata(assocId, documentId);
      allow update: if documentExists(assocId, documentId)
        && hasCapability(assocId, 'association.manage')
        && documentType()
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && validDocumentMetadata(assocId, documentId)
        && request.resource.metadata.associationId == resource.metadata.associationId
        && request.resource.metadata.documentId == resource.metadata.documentId;
      allow delete: if documentExists(assocId, documentId)
        && hasCapability(assocId, 'association.manage')
        && resource.metadata.associationId == assocId
        && resource.metadata.documentId == documentId
        && resource.metadata.visibility == 'internal';
    }

    // Legacy global roots and every unknown path are intentionally denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
