.local/production-readiness/
.local/stat-migration/

# Firebase service configs (contain API keys / project IDs)
# Uncomment below if you want to keep these out of version control.
# They are safe to commit (restricted by security rules + App Check),
# but some teams prefer to inject them via CI.
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist

